# Public site URL. Set this on Vercel after the first deploy.
NEXT_PUBLIC_SITE_URL=https://seventeen-recruitment-keagana26s-projects.vercel.app

# Sanity CMS. Leave blank to show the sample education jobs.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Postgres for applications, talent registrations, school requests and contact messages.
DATABASE_URL=

# Cloudflare R2 for private CV storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloudflare Turnstile. Forms stay closed until both keys are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Microsoft Graph mail notifications to the recruitment team.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAIL_FROM=
STAFF_NOTIFY_EMAIL=hello@seventeenrecruitment.co.uk
